# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/vera

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=7d

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_JOIN_PRICE_ID=price_...          # $3.99 one-time join fee
STRIPE_SUBSCRIPTION_PRICE_ID=price_... # $0.99/month subscription

# ─── Persona (Age Verification) ───────────────────────────────────────────────
PERSONA_API_KEY=persona_...
PERSONA_WEBHOOK_SECRET=persona_webhook_secret_...
PERSONA_TEMPLATE_ID=itmpl_...

# ─── App ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://app.vera.social
